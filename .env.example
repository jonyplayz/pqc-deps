# Copy to .env (git-ignored). The pipeline loads it automatically.

# --- Option A: Claude (default) ------------------------------------------
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# LLM_MODEL=claude-opus-5-5

# --- Option B: a free / OpenAI-compatible provider, for testing ----------
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   # Google Gemini
# LLM_BASE_URL=https://api.groq.com/openai/v1                            # Groq
# LLM_BASE_URL=https://openrouter.ai/api/v1                              # OpenRouter
# LLM_BASE_URL=http://localhost:11434/v1                                 # Ollama (local)
# LLM_API_KEY=
# LLM_MODEL=        # a model name from your provider's docs
# LLM_DELAY_MS=5000 # pause between libraries, for free-tier rate limits

# --- GitHub ----------------------------------------------------------------
# Optional locally (falls back to your `gh` login). Set automatically in Actions.
# GITHUB_TOKEN=
