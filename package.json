{
  "name": "pqc-deps",
  "private": true,
  "type": "module",
  "description": "PQC Deps: post-quantum readiness catalog for open-source libraries",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "site",
    "pipeline"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "validate": "tsx packages/core/scripts/validate.ts",
    "schema:json": "tsx packages/core/scripts/gen-json-schema.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p site/tsconfig.functions.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "npm run dev -w @pqc-deps/site",
    "dev:examples": "cross-env PQC_DATA_DIR=data/examples npm run dev -w @pqc-deps/site",
    "build": "npm run build -w @pqc-deps/site",
    "build:examples": "cross-env PQC_DATA_DIR=data/examples npm run build -w @pqc-deps/site",
    "pipeline": "npm run -s propose -w @pqc-deps/pipeline --",
    "stale": "npm run -s stale -w @pqc-deps/pipeline --",
    "identity": "npm run -s identity -w @pqc-deps/pipeline --",
    "check-quotes": "npm run -s check-quotes -w @pqc-deps/pipeline --",
    "add-library": "npm run -s add-library -w @pqc-deps/pipeline --",
    "dev:functions": "npm run build && npm run dev:functions -w @pqc-deps/site"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "cross-env": "^10.1.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
