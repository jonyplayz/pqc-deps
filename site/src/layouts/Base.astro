---
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/opsz-italic.css';
import '@fontsource/ibm-plex-sans/latin-400.css';
import '@fontsource/ibm-plex-sans/latin-500.css';
import '@fontsource/ibm-plex-sans/latin-600.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '../styles/global.css';
import { SITE } from '../config';
import { usingExampleData } from '../lib/catalog';

interface Props {
  title?: string;
  description?: string;
  /** Extra JSON-LD object for this page. */
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
}
const { title, description = SITE.description, jsonLd, noindex = false } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.name}` : `${SITE.name}: ${SITE.tagline}`;
// Clean public path: build.format "file" makes pathname end in .html.
const cleanPath =
  Astro.url.pathname.replace(/\.html$/, '').replace(/(^|\/)index$/, '/') || '/';
const canonical = new URL(cleanPath, Astro.site);
const examples = usingExampleData();
const nav = [
  { href: '/catalog', label: 'Catalog' },
  { href: '/check', label: 'Check my project' },
  { href: '/methodology', label: 'Methodology' },
  { href: '/about', label: 'About' },
];
const path = cleanPath.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="google-site-verification" content="-StfukkGEH_7BoV31XEZKFFdVwBjgUas7COPsT2yrgw" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(noindex || examples) && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="color-scheme" content="light dark" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="sr-only skip" href="#main">Skip to content</a>
    {
      examples && (
        <div class="example-banner" role="note">
          Sample build: showing <strong>fictional example data</strong>, not real library facts.
        </div>
      )
    }
    <header class="site-header">
      <div class="container bar">
        <a class="brand" href="/">
          <svg class="logo" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
            <circle cx="5" cy="5" r="2.4" fill="currentColor" />
            <circle cx="12" cy="5" r="2.4" fill="currentColor" />
            <circle cx="19" cy="5" r="2.4" fill="currentColor" />
            <circle cx="5" cy="12" r="2.4" fill="currentColor" />
            <circle cx="12" cy="12" r="2.4" class="logo-hot" />
            <circle cx="19" cy="12" r="2.4" fill="currentColor" />
            <circle cx="5" cy="19" r="2.4" fill="currentColor" />
            <circle cx="12" cy="19" r="2.4" fill="currentColor" />
            <circle cx="19" cy="19" r="2.4" fill="currentColor" />
          </svg>
          <span>PQC <i>Deps</i></span>
        </a>
        <nav aria-label="Main">
          <ul>
            {
              nav.map((n) => (
                <li>
                  <a href={n.href} aria-current={path === n.href ? 'page' : undefined}>
                    {n.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>
    <main id="main" class="container">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <p class="footer-brand">PQC <i>Deps</i></p>
        <p>
          {SITE.name} is a community project. Every claim links to a public source; corrections are
          welcome on <a href={SITE.repoUrl}>GitHub</a>.
        </p>
        <p class="muted small">
          Code: MIT. Data: <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>.
          Not affiliated with any library listed. Not security advice.
        </p>
        <nav class="footer-nav small" aria-label="Footer">
          <a href="/request">Request a library</a>
          <a href="/privacy">Privacy</a>
          <a href="/terms">Terms</a>
          <a href={`${SITE.repoUrl}/security/policy`}>Report a security issue</a>
          <a href="/api/catalog.json">JSON API</a>
        </nav>
      </div>
    </footer>
  </body>
</html>

<style>
  .skip:focus {
    position: fixed;
    top: 8px;
    left: 8px;
    width: auto;
    height: auto;
    clip: auto;
    padding: 0.5rem 0.75rem;
    background: var(--surface);
    z-index: 20;
  }
  .example-banner {
    background: var(--st-partial-bg);
    color: var(--st-partial);
    text-align: center;
    font-size: 0.875rem;
    padding: 0.4rem 16px;
  }
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    border-top: 3px solid var(--accent);
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg) 86%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    min-height: 62px;
    padding-block: 0.5rem;
  }
  .brand {
    font-family: var(--display);
    font-weight: 600;
    font-size: 1.35rem;
    letter-spacing: -0.02em;
    color: var(--text);
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }
  .brand i,
  .footer-brand i {
    color: var(--accent);
    font-weight: 500;
  }
  .logo {
    color: var(--text);
    transition: transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .logo-hot {
    fill: var(--accent);
  }
  .brand:hover .logo {
    transform: rotate(45deg);
  }
  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    position: relative;
    color: var(--muted);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.92rem;
    padding-block: 0.3rem;
  }
  nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.2s ease;
  }
  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--text);
  }
  nav a:hover::after,
  nav a[aria-current='page']::after {
    transform: scaleX(1);
  }
  main {
    padding-block: 2.5rem 5rem;
    min-height: 60vh;
  }
  .site-footer {
    background: var(--ink-band);
    color: var(--ink-band-text);
    padding-block: 2.5rem 2rem;
    font-size: 0.9rem;
  }
  .site-footer .muted {
    color: var(--ink-band-muted);
  }
  .site-footer a {
    color: var(--ink-band-text);
  }
  .site-footer p {
    margin: 0.3rem 0;
    max-width: 46rem;
  }
  .footer-brand {
    font-family: var(--display);
    font-size: 1.6rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    margin-bottom: 0.75rem !important;
  }
  .footer-brand i {
    color: #ff8a3d;
  }
  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.5rem;
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid rgb(236 232 221 / 0.15);
    font-family: var(--mono);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
  }
  .footer-nav a {
    color: var(--ink-band-muted);
    text-decoration: none;
  }
  .footer-nav a:hover {
    color: #ff8a3d;
  }
</style>
