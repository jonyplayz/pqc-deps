---
import { STATUS_INFO, type Status } from '@pqc-deps/core';
interface Props {
  status: Status;
  size?: 'sm' | 'lg';
}
const { status, size = 'sm' } = Astro.props;
const info = STATUS_INFO[status];
const cls = status === 'n/a' ? 'na' : status;
---

<span class={`badge st-${cls} ${size}`} title={info.description}>{info.label}</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    font-family: var(--mono);
    font-weight: 500;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1;
    padding: 0.42em 0.65em 0.42em 0.55em;
    border-radius: 3px;
    white-space: nowrap;
    color: var(--c);
    background: var(--b);
    border: 1px solid color-mix(in srgb, var(--c) 30%, transparent);
  }
  .badge::before {
    content: '';
    width: 0.55em;
    height: 0.55em;
    border-radius: 50%;
    background: var(--c);
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--c) 22%, transparent);
  }
  .lg {
    font-size: 0.85rem;
    padding: 0.55em 0.85em 0.55em 0.7em;
  }
  .st-ready { --c: var(--st-ready); --b: var(--st-ready-bg); }
  .st-available { --c: var(--st-available); --b: var(--st-available-bg); }
  .st-partial { --c: var(--st-partial); --b: var(--st-partial-bg); }
  .st-planned { --c: var(--st-planned); --b: var(--st-planned-bg); }
  .st-no-plan { --c: var(--st-no-plan); --b: var(--st-no-plan-bg); }
  .st-unknown { --c: var(--st-unknown); --b: var(--st-unknown-bg); }
  .st-na { --c: var(--st-na); --b: var(--st-na-bg); }
</style>
