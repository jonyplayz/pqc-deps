---
import { ALGORITHM_INFO, SUPPORT_LABEL, type Algorithm, type Library, applicableAlgorithms } from '@pqc-deps/core';
interface Props {
  library: Library;
  algorithm: Algorithm;
}
const { library, algorithm } = Astro.props;
const applicable = applicableAlgorithms(library).includes(algorithm);
const s = library.algorithms[algorithm];
const level = !applicable && !s ? 'na' : (s?.support ?? 'unknown');
const symbol = { yes: '✓', partial: '◐', no: '✕', unknown: '?', na: '–' }[level];
const label =
  level === 'na'
    ? 'Not applicable'
    : SUPPORT_LABEL[level as keyof typeof SUPPORT_LABEL] +
      (s?.since_version ? ` since ${s.since_version}` : '') +
      (s?.experimental ? ' (experimental)' : '');
---

<span class={`mark m-${level}`} title={`${ALGORITHM_INFO[algorithm].label}: ${label}`}>
  <span aria-hidden="true">{symbol}</span>
  <span class="sr-only">{label}</span>
</span>

<style>
  .mark {
    display: inline-grid;
    place-items: center;
    width: 1.7rem;
    height: 1.7rem;
    border-radius: 3px;
    font-family: var(--mono);
    font-weight: 500;
    font-size: 0.85rem;
  }
  .m-yes { color: var(--st-ready); background: var(--st-ready-bg); box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--st-ready) 35%, transparent); }
  .m-partial { color: var(--st-partial); background: var(--st-partial-bg); box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--st-partial) 35%, transparent); }
  .m-no { color: var(--st-no-plan); background: var(--st-no-plan-bg); }
  .m-unknown { color: var(--st-unknown); background: transparent; box-shadow: inset 0 0 0 1px var(--border); }
  .m-na { color: var(--border); }
</style>
