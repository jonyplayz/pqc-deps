---
import type { DelegationNode } from '@pqc-deps/core';
import StatusBadge from './StatusBadge.astro';
interface Props {
  nodes: DelegationNode[];
}
const { nodes } = Astro.props;
---

<ul class="tree">
  {
    nodes.map((n) => (
      <li>
        <a href={`/libraries/${n.library.id}`}>{n.library.name}</a>{' '}
        <StatusBadge status={n.library.overall_status} />
        {n.condition && <span class="muted small"> ({n.condition})</span>}
        {n.children.length > 0 && <Astro.self nodes={n.children} />}
      </li>
    ))
  }
</ul>

<style>
  .tree {
    list-style: none;
    margin: 0.25rem 0;
    padding-left: 1.1rem;
    border-left: 2px solid var(--border);
  }
  .tree li {
    margin: 0.35rem 0;
  }
  .tree li::before {
    content: '↳ ';
    color: var(--muted);
  }
</style>
