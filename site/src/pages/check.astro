---
import Base from '../layouts/Base.astro';
---

<Base
  title="Check my project"
  description="Paste a dependency manifest and see which dependencies are quantum-vulnerable. Parsed entirely in your browser."
>
  <div class="prose">
    <h1>Check my project</h1>
    <p class="lede">
      Paste a <code>package.json</code>, <code>requirements.txt</code>, <code>go.mod</code>,
      <code>pom.xml</code>, <code>Cargo.toml</code> or similar, and see which dependencies do
      cryptography, their post-quantum status, and what to upgrade.
    </p>
    <p class="notice">The checker is under construction and will be available soon.</p>
  </div>
</Base>
