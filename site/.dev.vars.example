# Copy to site/.dev.vars for `npm run dev:functions` (git-ignored).
# These Turnstile keys are Cloudflare's public test keys: the check always passes.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
GITHUB_REPO=jonyplayz/pqc-deps
# A fine-grained token to test GitHub calls locally (leave empty to skip):
GITHUB_TOKEN=
# "Sign in with GitHub" needs an OAuth app whose callback is
# http://localhost:8788/api/auth/callback to work locally (optional):
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# SESSION_SECRET is optional: derived from the client secret when unset.
