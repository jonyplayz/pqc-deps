# Cloudflare Pages response headers for static files.
# The script/style policy is in each page's CSP <meta> tag (astro.config.mjs);
# these add the directives a <meta> tag can't set, and other hardening.
/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: frame-ancestors 'none'; object-src 'none'; base-uri 'self'

# Build output has content hashes in file names, so it can be cached forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# The JSON API changes when the catalog does; cache briefly.
/api/catalog.json
  Cache-Control: public, max-age=300
  Access-Control-Allow-Origin: *
/api/libraries/*
  Cache-Control: public, max-age=300
  Access-Control-Allow-Origin: *

/admin
  X-Robots-Tag: noindex
